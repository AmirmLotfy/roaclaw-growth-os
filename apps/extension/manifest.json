{
  "manifest_version": 3,
  "name": "ROACLAW",
  "description": "Capture public landing-page evidence and approve research bookmarks from your ROACLAW workspace.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "optional_permissions": [
    "bookmarks"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open ROACLAW companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://roaclaw-growth-os-2026.web.app/*",
      "https://roaclaw-growth-os-2026.firebaseapp.com/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  }
}
