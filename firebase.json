{
  "auth": {
    "providers": {
      "anonymous": true
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "roaclaw-growth-os-2026",
    "public": "apps/web/out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/demo-store{,/**}",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "/roaclaw-extension.zip",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
